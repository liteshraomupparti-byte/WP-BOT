<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Products</title>

<style>
body{
font-family:Arial;
background:#f5f5f5;
margin:0;
}

.header{
background:#111;
color:white;
padding:20px;
text-align:center;
font-size:30px;
}

.delete-btn{
width:100%;
padding:12px;
margin-top:0;
background:#d32f2f;
color:white;
border:none;
border-radius:8px;
font-size:16px;
font-weight:bold;
cursor:pointer;
}

.delete-btn:hover{
background:#b71c1c;
}

.container{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
gap:20px;
padding:30px;
}

.card{
background:white;
border-radius:15px;
padding:20px;
box-shadow:0 10px 20px rgba(0,0,0,.15);
}

img{
width:100%;
height:250px;
object-fit:cover;
border-radius:10px;
background:#e2e8f0;
}

h2{
margin:10px 0;
}

.price{
color:red;
font-size:22px;
font-weight:bold;
}

.category{
background:#111;
color:white;
display:inline-block;
padding:5px 12px;
border-radius:20px;
margin-top:10px;
margin-bottom:15px;
}

.buttons{
display:flex;
gap:10px;
}

.edit{
flex:1;
background:#d4af37;
color:black;
padding:12px;
text-align:center;
border-radius:8px;
text-decoration:none;
font-weight:bold;
}

.delete{
flex:1;
background:#e53935;
color:white;
padding:12px;
text-align:center;
border-radius:8px;
text-decoration:none;
font-weight:bold;
}

.edit:hover{
background:#c49b2c;
}

.delete:hover{
background:#c62828;
}
</style>
</head>

<body>

<div class="header">
Devika Collections Products
</div>

<div class="container">

<% if (products && products.length > 0) { %>
  <% products.forEach((product) => { %>
    <div class="card">
      <img src="<%= product.image %>" alt="<%= product.name %>" onerror="this.onerror=null; this.src='https://placehold.co/400x300/f1f5f9/475569?text=Image+Not+Found';">
      <h2><%= product.name %></h2>
      <div class="price">₹<%= product.price %></div>
      <div class="category"><%= product.category %></div>
      <% if (product.description) { %>
        <p style="color:#666; font-size:14px;"><%= product.description %></p>
      <% } %>
      <div class="buttons">
        <a href="/admin/edit-product/<%= product.id || product._id %>" class="edit">✏️ Edit</a>
        <form action="/admin/delete/<%= product.id || product._id %>" method="POST" style="flex:1; margin:0;" onsubmit="return confirm('Are you sure you want to delete this product?');">
          <button type="submit" class="delete-btn">🗑 Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } else { %>
  <div style="grid-column: 1 / -1; text-align: center; font-size: 18px; color: #777; margin-top: 50px;">
    No products found in MongoDB. <a href="/admin/add-product">Add Product</a>
  </div>
<% } %>

</div>

</body>
</html>